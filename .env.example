# Base Network RPC URLs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Private key for deployment (DO NOT COMMIT THIS)
PRIVATE_KEY=your_private_key_here

# Protocol fee recipient (5% on death, 1% on sell). Default: 0xEb45918A1efC99C84Fa337E36A2F84317a9DE1b8
# PROTOCOL_TREASURY=0xEb45918A1efC99C84Fa337E36A2F84317a9DE1b8

# BaseScan API key (for contract verification: npx hardhat verify --network baseMainnet ...)
# Get one at https://basescan.org/myapikey
# BASESCAN_API_KEY=your_basescan_api_key

# Contract address (Base Mainnet) — ОБЯЗАТЕЛЬНО новый контракт (после фикса «монстр убит → можно создать снова»)
# New (victim slot cleared on kill, 3 days hunger): 0x3A52Fd151Aa9501c7BDB50C0247caA8607B18711
# Old (manual withdraw): 0x03082c8ca5208E538cc5A4Cf0e669E2B035Ff80A
NEXT_PUBLIC_CONTRACT_ADDRESS=0x3A52Fd151Aa9501c7BDB50C0247caA8607B18711

# ERC-1155 achievement badges (optional; leave empty to hide mint)
# NEXT_PUBLIC_BADGES_CONTRACT_ADDRESS=0x...

# Private key of the owner of the badges contract (for API claim: all badges mint). Server-only, do not commit.
# BADGES_OWNER_PRIVATE_KEY=0x...

# Optional: block number when game contract was deployed (speeds up event scan for Zombie/Ice/Demon claims).
# GAME_CONTRACT_DEPLOY_BLOCK=12345678

# Hunger window in days: 3 for Base Mainnet. Use 1 for Base Sepolia testnet.
NEXT_PUBLIC_HUNGER_DAYS=3

# Optional: Neynar API key to show Farcaster/Base App profile names in Hunt cards (get at neynar.com)
# NEYNAR_API_KEY=your_neynar_api_key

# Ссылки на соцсети (отображаются внизу страницы)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/monstrohunt
NEXT_PUBLIC_TWITTER_URL=https://x.com/super_jenork
