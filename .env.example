# Base Network RPC URLs
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Private key for deployment (DO NOT COMMIT THIS)
PRIVATE_KEY=your_private_key_here

# Protocol fee recipient (5% on death, 1% on sell). Default: 0xEb45918A1efC99C84Fa337E36A2F84317a9DE1b8
# PROTOCOL_TREASURY=0xEb45918A1efC99C84Fa337E36A2F84317a9DE1b8

# Contract address (Base Mainnet deployment)
NEXT_PUBLIC_CONTRACT_ADDRESS=0xe98B017b0FF1CEB9e3794883288072Db51382618

# Hunger window in days: 7 for Base Mainnet (omit = 7). Use 1 for Base Sepolia testnet.
NEXT_PUBLIC_HUNGER_DAYS=7

# Ссылки на соцсети (отображаются внизу страницы)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/monstrohunt
NEXT_PUBLIC_TWITTER_URL=https://x.com/super_jenork
