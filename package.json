{
  "name": "monstro-hunt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "compile": "hardhat compile",
    "deploy:sepolia": "hardhat run scripts/deploy.mjs --network baseSepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.mjs --network baseMainnet",
    "deploy:badges:mainnet": "hardhat run scripts/deploy-badges.mjs --network baseMainnet",
    "deploy:badges:sepolia": "hardhat run scripts/deploy-badges.mjs --network baseSepolia"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@tanstack/react-query": "^5.90.21",
    "next": "^15.5.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.47.2",
    "wagmi": "^2.19.5"
  },
  "engines": {
    "node": "20.x"
  },
  "overrides": {
    "use-sync-external-store": "1.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.6",
    "@nomicfoundation/hardhat-verify": "^3.0.12",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "dotenv": "^16.0.0",
    "eslint": "^8",
    "eslint-config-next": "^15.5.12",
    "ethers": "^6.0.0",
    "hardhat": "^3.1.12",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
